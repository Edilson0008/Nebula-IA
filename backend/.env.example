# Copie este arquivo para .env e preencha com sua chave
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-flash-lite-latest
GEMINI_MEMORY_MODEL=gemini-3.1-flash-lite
GEMINI_MEMORY_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-lite-image-preview,gemini-3.1-flash-lite-image,gemini-2.5-flash-image-preview,gemini-3.0-flash-image,gemini-2.5-flash-image,imagen-4.0-generate-001

# Chaves extras para aumentar cota de imagens (opcional)
# GEMINI_API_KEYS=AIza...,AIza...
