# Cole sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo usado pela IA (pode trocar depois)
GEMINI_MODEL=gemini-3.8-flash

# Modelos de RESERVA: se a cota (ou o modelo) do principal falhar, a Nébula
# troca sozinha para o próximo da lista e você continua conversando.
# Cada modelo tem a própria cota, então cada linha aqui é como "mais mensagens".
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Modelo leve usado só para aprender/lembrar fatos (memória de longo prazo).
# Também tem cota própria, então não gasta as conversas.
GEMINI_MEMORY_MODEL=gemini-3.1-flash-lite
GEMINI_MEMORY_FALLBACK_MODELS=gemini-3.5-flash-lite

# Modelo usado para a memória de longo prazo (embeddings)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pasta onde os sites/arquivos criados pela IA são salvos.
# Deixe em uma pasta que você consiga abrir no gerenciador de arquivos.
# No celular (Termux): /sdcard/Download/nebula-projetos
# No computador: ./workspace  (padrão, dentro de backend/)
WORKSPACE_DIR=/sdcard/Download/nebula-projetos

# Quão parecido um fato precisa ser para entrar na memória (0 a 1).
# Maior = mais rígido. 0.66 costuma ser um bom equilíbrio.
MEMORY_MIN_SCORE=0.66

# ------------------------------------------------------------------ agente
# Modo agente: quando o pedido envolve compilar/instalar/executar, a Nébula
# usa ferramentas de verdade (ler/escrever arquivos e rodar comandos) até a
# tarefa ficar pronta — inclusive gerar .apk de app Android.
# Desligue com 0 se quiser respostas só de conversa.
AGENT_ENABLED=1

# Trava dos comandos:
#   ask    = comandos DENTRO do projeto rodam direto; fora dele pede
#            aprovação na tela (botões Permitir/Negar)  [padrão]
#   always = toda a lista de comandos roda sem perguntar
#   never  = só pode rodar comandos DENTRO do projeto (nunca fora)
AGENT_SHELL=ask

# Quantos segundos a aprovação fica esperando o clique antes de negar sozinho.
AGENT_APPROVAL_TIMEOUT=120

